+    @staticmethod
+    def _require_valid_index(index, size, context):
+        """Turn malformed generated topology into a catchable Python error.
+
+        CUDA advanced indexing reports invalid indices asynchronously.  Once
+        that device-side assert fires the whole evaluator process is unusable,
+        so every generated topology index is checked before launching the
+        corresponding indexing kernel.
+        """
+        size = int(size)
+        invalid = (index < 0) | (index >= size)
+        if bool(invalid.any().item()):
+            invalid_count = int(invalid.sum().item())
+            minimum = int(index.min().item()) if index.numel() else None
+            maximum = int(index.max().item()) if index.numel() else None
+            raise RuntimeError(
+                "FlexiCubes topology index is inconsistent: "
+                f"context={context} invalid={invalid_count} "
+                f"total={index.numel()} size={size} min={minimum} max={maximum}"
+            )
