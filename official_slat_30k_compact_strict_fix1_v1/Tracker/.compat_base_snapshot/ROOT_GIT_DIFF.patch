+        Vector3 requestedPosition = cameraFramePosition;
+        Quaternion requestedRotation = cameraFrameRotation;
+        try
+        {
+            captureReferenceAnchor = anchorManager.AddAnchor(
+                new Pose(
+                    requestedPosition,
+                    requestedRotation
