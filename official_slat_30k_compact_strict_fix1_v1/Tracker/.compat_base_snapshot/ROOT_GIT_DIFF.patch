+def _replace_nested_identity_value(
+    identity: dict[str, Any], field: tuple[str, ...], value: Any
+) -> None:
+    parent: Any = identity
+    for key in field[:-1]:
+        parent = parent[key]
+    parent[field[-1]] = value
