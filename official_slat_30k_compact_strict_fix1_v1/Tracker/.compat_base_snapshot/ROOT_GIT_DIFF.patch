+    mesh.calls = []
+    mesh.get_edges = lambda: mesh.calls.append("get_edges")
+    mesh.get_boundary_info = lambda: mesh.calls.append("get_boundary_info")
+    mesh.get_vertex_edge_adjacency = lambda: mesh.calls.append(
