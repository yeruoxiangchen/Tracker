+def _nested_identity_value(identity: dict[str, Any], field: tuple[str, ...]) -> Any:
+    value: Any = identity
+    for key in field:
+        if not isinstance(value, dict) or key not in value:
+            raise RuntimeError(
+                "resume data identity is missing approved path field: "
+                + ".".join(field)
+            )
+        value = value[key]
+    return value
