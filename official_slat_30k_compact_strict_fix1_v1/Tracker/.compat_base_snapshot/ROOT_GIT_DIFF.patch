+class _FakeCuMesh:
+    def __init__(self, *, boundaries: int, loops: int):
+        self.num_boundaries = boundaries
+        self.num_boundary_loops = loops
+        self.calls: list[str] = []
+
+    def __getattr__(self, name: str):
+        if name.startswith("get_") or name.startswith("read_"):
+            return lambda: self.calls.append(name)
+        raise AttributeError(name)
+
+
+def test_cumesh_fill_holes_guard_skips_empty_boundaries():
+    mesh = _FakeCuMesh(boundaries=0, loops=0)
+    original_calls: list[float] = []
+    _guarded_fill_holes(
+        mesh,
+        lambda _mesh, max_hole_perimeter: original_calls.append(
+            max_hole_perimeter
+        ),
+    )
+    assert mesh.calls == ["get_edges", "get_boundary_info"]
+    assert original_calls == []
+
+
+def test_cumesh_fill_holes_guard_skips_empty_boundary_loops():
+    mesh = _FakeCuMesh(boundaries=3, loops=0)
+    original_calls: list[float] = []
+    _guarded_fill_holes(
+        mesh,
+        lambda _mesh, max_hole_perimeter: original_calls.append(
+            max_hole_perimeter
+        ),
+    )
+    assert mesh.calls[-1] == "get_boundary_loops"
+    assert original_calls == []
+
+
+def test_cumesh_fill_holes_guard_preserves_real_fill_and_restores_method():
+    class FakeType:
+        def fill_holes(self, max_hole_perimeter: float = 3e-2):
+            self.original_perimeter = max_hole_perimeter
