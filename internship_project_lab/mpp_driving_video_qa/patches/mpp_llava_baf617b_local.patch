+_LEGACY_FINAL_NORM = "llm_model.transformer.final_h.32norm.weight"
+_CURRENT_FINAL_NORM = "llm_model.transformer.ln_f.weight"
+
+
+def _load_sharded_safetensors(model, index_path):
+    """Copy an indexed safetensors checkpoint into ``model`` one shard at a time.
+
+    Unlike ``torch.load`` followed by ``load_state_dict``, this never materializes
+    the complete checkpoint beside the already constructed model on CPU.
+    """
+    from safetensors import safe_open
+    from torch.nn.modules.module import _IncompatibleKeys
+
+    with open(index_path, "r", encoding="utf-8") as handle:
+        index = json.load(handle)
+    weight_map = index.get("weight_map")
+    if not isinstance(weight_map, dict) or not weight_map:
+        raise RuntimeError(f"invalid safetensors index: {index_path}")
+
+    model_state = model.state_dict()
+    model_keys = set(model_state)
+    source_keys = set(weight_map)
+    effective_keys = set(source_keys)
+    remapped_keys = {}
+    if _LEGACY_FINAL_NORM in source_keys and _CURRENT_FINAL_NORM not in source_keys:
+        effective_keys.remove(_LEGACY_FINAL_NORM)
+        effective_keys.add(_CURRENT_FINAL_NORM)
+        remapped_keys[_LEGACY_FINAL_NORM] = _CURRENT_FINAL_NORM
+
+    shard_names = list(dict.fromkeys(weight_map.values()))
+    loaded_keys = set()
+    unexpected_keys = []
+    index_dir = os.path.dirname(os.path.abspath(index_path))
+    with torch.no_grad():
+        for shard_number, shard_name in enumerate(shard_names, 1):
+            shard_path = os.path.join(index_dir, shard_name)
+            if not os.path.isfile(shard_path):
+                raise RuntimeError(f"checkpoint shard is missing: {shard_path}")
+            print(
+                f"Loading MPP checkpoint shard {shard_number}/{len(shard_names)}: {shard_name}",
+                flush=True,
+            )
+            with safe_open(shard_path, framework="pt", device="cpu") as shard:
+                for source_key in shard.keys():
+                    target_key = remapped_keys.get(source_key, source_key)
+                    if weight_map.get(source_key) != shard_name:
+                        raise RuntimeError(
+                            f"checkpoint index mismatch for {source_key}: "
+                            f"{weight_map.get(source_key)} vs {shard_name}"
+                        )
+                    if target_key not in model_state:
+                        unexpected_keys.append(target_key)
+                        continue
+                    source = shard.get_tensor(source_key)
+                    target = model_state[target_key]
+                    if source.shape != target.shape:
+                        raise RuntimeError(
+                            f"checkpoint shape mismatch for {target_key}: "
+                            f"{tuple(source.shape)} vs {tuple(target.shape)}"
+                        )
+                    target.copy_(source.to(dtype=target.dtype))
+                    loaded_keys.add(target_key)
+                    del source
+
+    missing_keys = sorted(model_keys - loaded_keys)
+    unexpected_keys = sorted(set(unexpected_keys) | (effective_keys - model_keys))
+    report = {
+        "path": os.path.abspath(index_path),
+        "format": "sharded_safetensors",
+        "shard_count": len(shard_names),
+        "checkpoint_key_count": len(effective_keys),
+        "model_key_count": len(model_keys),
+        "matched_key_count": len(loaded_keys),
+        "missing_key_count": len(missing_keys),
+        "unexpected_key_count": len(unexpected_keys),
+        "missing_keys": missing_keys,
+        "unexpected_keys": unexpected_keys,
+        "remapped_keys": remapped_keys,
+    }
+    return _IncompatibleKeys(missing_keys, unexpected_keys), report
+
